{
  "name": "studyai-ecosystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:fastapi\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:fastapi": "PYTHONPATH=. venv/bin/uvicorn fastapi_server.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:fastapi": "PYTHONPATH=. venv/bin/pytest tests/test_fastapi_tutor.py",
    "test:frontend": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
