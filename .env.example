# STUDYAI Server Environment Configuration
# Keep all private API credentials on the server. Never expose secrets in client code.

PORT=3001

# Supabase Integration Configuration
# Provide your Supabase project URL and keys to connect remote database & storage
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
# Server-side only (never expose in client code):
SUPABASE_SERVICE_ROLE_KEY=

# Optional External AI Provider Keys (Server-Side Only)
# When provided, server/aiAdapter.ts connects to live external endpoints (Gemini / Nano Banana, OpenAI GPT, Groq).
# When omitted, STUDYAI transparently operates in Local Curriculum & Procedural Synthesis Mode.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
VIDEO_API_KEY=
